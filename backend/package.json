    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "winston": "^3.19.0"
